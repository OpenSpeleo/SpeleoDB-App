{
  "name": "speleodb-mobile",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "bundle:report": "npm run build && node ./scripts/report-bundle-stats.mjs",
    "quality:inventory": "node ./scripts/verify-quality-inventory.mjs",
    "build:native:ios:assets": "node scripts/build-native-assets.mjs ios",
    "build:native:android:assets": "node scripts/build-native-assets.mjs android",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test:ci": "npm run test.unit -- --run --coverage --no-file-parallelism",
    "test:browser": "playwright test",
    "test.unit": "bash ./scripts/run-vitest.sh",
    "lint": "eslint",
    "postinstall": "node scripts/patch-sentry-capacitor-package.mjs && node scripts/patch-capgo-compass-package.mjs"
  },
  "dependencies": {
    "@capacitor-community/background-geolocation": "1.2.26",
    "@capacitor/android": "8.5.2",
    "@capacitor/app": "8.1.1",
    "@capacitor/browser": "^8.0.4",
    "@capacitor/core": "8.5.2",
    "@capacitor/device": "^8.0.3",
    "@capacitor/filesystem": "^8.1.3",
    "@capacitor/geolocation": "^8.2.2",
    "@capacitor/haptics": "8.0.2",
    "@capacitor/ios": "8.5.2",
    "@capacitor/keyboard": "8.0.5",
    "@capacitor/share": "^8.0.2",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "8.0.3",
    "@capawesome-team/capacitor-android-battery-optimization": "8.0.1",
    "@capgo/capacitor-compass": "8.1.20",
    "@ionic/react": "^8.8.19",
    "@ionic/react-router": "^9.0.3",
    "@sentry/capacitor": "^4.3.0",
    "@sentry/react": "10.69.0",
    "@turf/helpers": "^7.4.0",
    "@types/react-router": "^5.1.20",
    "@types/react-router-dom": "^5.3.3",
    "driver.js": "^1.8.0",
    "gpx-builder": "^6.0.0",
    "ionicons": "^8.1.0",
    "maplibre-gl": "^6.10.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-map-gl": "^8.1.3",
    "react-router": "^5.3.4",
    "react-router-dom": "^5.3.4"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "@eslint/js": "^9.39.5",
    "@j178/prek": "^0.5.3",
    "@maplibre/maplibre-gl-style-spec": "^26.4.4",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": ">=10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/geojson": "^7946.0.16",
    "@types/history": "^4.7.11",
    "@types/node": "^26.6.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-legacy": "^8.2.3",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.1",
    "autoprefixer": "^10.6.1",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.12.0",
    "history": "^4.10.1",
    "jsdom": "^30.0.1",
    "lint-staged": "^17.5.1",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3",
    "terser": "^5.51.2",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  },
  "lint-staged": {
    "*.{ts,tsx}": "eslint --fix"
  },
  "description": "An Ionic project",
  "allowScripts": {
    "@sentry/capacitor@4.3.0": true,
    "core-js@3.50.0": true,
    "@maplibre/maplibre-gl-style-spec@19.3.3": true,
    "fsevents@2.3.2": true,
    "fsevents@2.3.3": true
  }
}
