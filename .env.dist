# SpeleoDB API Test Configuration
# Copy this file to .env and fill in your actual credentials

# SpeleoDB Instance Configuration
SPELEODB_INSTANCE_URL=www.speleodb.org

# ==================== Authentication ==================== #

# Option 1: OAuth Token
SPELEODB_OAUTH_TOKEN=your-oauth-token-here

# Option 2: Email/Password
SPELEODB_EMAIL=your-email@example.com
SPELEODB_PASSWORD=your-password-here

# ==================== Configuration ==================== #

# API Testing Configuration
API_TIMEOUT_MS=10000
API_RETRY_COUNT=3
API_TEST_ENABLED=true

# ==================== Sentry ==================== #
#
# Strict per-platform native builds use these values to inject a single
# VITE_SENTRY_DSN into the generated web assets.
#
# iOS build DSN (used by Xcode pre-build hook)
SENTRY_DSN_IOS=your-ios-sentry-dsn-here
#
# Android build DSN (used by Android Studio/Gradle pre-build hook)
SENTRY_DSN_ANDROID=your-android-sentry-dsn-here
